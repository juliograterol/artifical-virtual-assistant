/* 1. The width of the entire scrollbar */
*::-webkit-scrollbar {
  width: 6px;
}

/* 2. The background of the scrollbar area */
*::-webkit-scrollbar-track {
  background: transparent;
}

/* 3. The draggable handle */
*::-webkit-scrollbar-thumb {
  background-color: #cbd5e0; /* Subtle grey */
  border-radius: 10px; /* Round edges */
  border: 1px solid transparent; /* Padding effect */
}

/* 4. Handle on hover */
*::-webkit-scrollbar-thumb:hover {
  background-color: #a0aec0;
}

@layer base {
  /* Change 'input' to 'input, select, textarea' if you want to target all form fields */
  input:-webkit-autofill,
  input:-webkit-autofill:hover,
  input:-webkit-autofill:focus,
  input:-webkit-autofill:active {
    /* Forces the background to be transparent using an inset shadow */
    -webkit-box-shadow: 0 0 0 1000px transparent inset !important;

    /* Delays the browser's attempt to flash the default color */
    transition: background-color 50000s ease-in-out 0s;
  }
  * {
    @apply border-border outline-ring/50;
  }
  body {
    @apply bg-background text-foreground;
  }
  html {
    @apply font-sans;
  }
}

input {
