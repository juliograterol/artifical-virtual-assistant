<file path="components/animation.css">
.ava-logo {
  transform-style: preserve-3d;
}

.ava-logo .draw-once {
  stroke-dasharray: 900;
  stroke-dashoffset: 900;
  animation: draw-ava 2.2s ease-out forwards;
}

.ava-logo .delay {
  animation-delay: 0.6s;
}

@keyframes draw-ava {
  to {
    stroke-dashoffset: 0;
  }
}

.ava-logo .ava-bg {
  animation-delay: 5s;
  animation: chromed 2.2s ease-out forwards;
  filter: drop-shadow(0px 0px 0px white);
}

@keyframes chromed {
  75% {
    fill: transparent;
  }
  85%,
  95% {
    filter: drop-shadow(0px 0px 6px white);
  }
  to {
    fill: #fff;
  }
}

/* .ava-logo {
  animation: flip 1.5s linear forwards;
  animation-delay: 3s;
}
.ava-logo {
  will-change: transform;
}
@keyframes flip {
  from {
    transform: rotateY(0deg);
  }
  to {
    transform: rotateY(360deg);
  }
} */

.ava-logo.loop {
  transform-style: preserve-3d;
}

/* ✏️ stroke drawing */
.ava-logo.loop .draw-once {
  stroke-dasharray: 900;
  stroke-dashoffset: 900;

  animation: draw-ava 2.2s ease-in-out infinite alternate;
}

.ava-logo.loop .delay {
  animation-delay: 0.6s;
}

/* draw forward, then reverse automatically */
@keyframes draw-ava {
  from {
    stroke-dashoffset: 900;
  }
  to {
    stroke-dashoffset: 0;
  }
}

/* ✨ fill + glow loop */
.ava-logo.loop .ava-bg {
  animation: chromed 2.2s ease-in-out infinite alternate;
}

/* IMPORTANT: make this reversible-friendly */
@keyframes chromed {
  0% {
    fill: transparent;
    filter: drop-shadow(0px 0px 0px white);
  }

  70% {
    fill: transparent;
  }

  85% {
    filter: drop-shadow(0px 0px 6px white);
  }

  100% {
    fill: #fff;
    filter: drop-shadow(0px 0px 2px white);
  }
}

.mic-rect {
  transform-origin: bottom;
  transform: scaleY(0);
}

.mic-rect.active {
  animation: micFill 1.2s ease-in-out infinite;
}

@keyframes micFill {
  0% {
    transform: scaleY(0.2);
  }
  25% {
    transform: scaleY(0.9);
  }
  50% {
    transform: scaleY(0.4);
  }
  75% {
    transform: scaleY(0.8);
  }
  100% {
    transform: scaleY(0.3);
  }
}
